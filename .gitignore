# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- virtualenvs (several per-engine) ---
.venv/
venv/
.venv-*/

# --- local-only data, models, vendored engines ---
data/
*.db
*.db-wal
*.db-shm
models/
vendor/
checkpoints/
dist/

# --- build/runtime artifacts ---
