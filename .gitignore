data/**/*.wav
*.zip
*.log
data/run/
served.html
headers.txt

# --- 多 agent 任务看板（本机共享，不入库；要跨机同步再放开）---
.agent-board/

# --- 本地 agent 工作区与个人评审稿（绝不入库）---
.zcode/
.workbuddy/
staging/
memory_v6_review_*.md
scripts/send_continue.*
.opencode/
opencode.jsonc

# --- 本机覆盖配置（含真实路径/QQ，不入库；示例见 config/example.toml）---
config.local
config.local.toml

# --- secrets ---
.env

# --- editors / OS ---
.idea/
.vscode/
