# Copy to .env and fill in only what you need.
# OpenCode Go API key: https://opencode.ai/auth
# Preferred: a dedicated key for fatfish (avoids shell env collisions).
FATFISH_OPENCODE_KEY=
# Backward-compatible fallback used only if FATFISH_OPENCODE_KEY is empty.
OPENCODE_API_KEY=
FATFISH_PROFILE=low
# FATFISH_DATA_DIR=D:\fatfish-data
# FATFISH_DB=D:\fatfish-data\fatfish.db

# QQ / OneBot (NapCat forward WebSocket). Leave empty if auth is disabled.
QQ_ACCESS_TOKEN=

# Bilibili read-only login (optional; QR login writes data/bilibili_cookies.json).
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
# Full cookie string wins over the two values above when set.
# BILIBILI_COOKIE=SESSDATA=...; bili_jct=...
