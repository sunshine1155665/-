# fatfish 在线层 —— 云主机环境变量模板
#
# 复制成 /opt/fatfish/.env 并填值，然后 chmod 600、chown fatfish。
# systemd 的 EnvironmentFile 和 fatfish 自己的 .env 读取都会用它。

FATFISH_PROFILE=cloud

# LLM（OpenAI 兼容）。和本机 .env 里的同一个 key。
FATFISH_OPENCODE_KEY=

# NapCat OneBot v11 的 access token，必须和 WebUI 里 WebSocket 服务器的 token 一致。
QQ_ACCESS_TOKEN=

# 机器人 QQ 号（napcat-supervisor 用它做快速登录/日志归属）。
QQ_UIN=

# QQ 空间：聚合 feed 不可用时的逐好友回退（逗号分隔，见 ADR-0011）。
# 不写也行，回退只是不生效；写了才有数据。
QZONE_FRIEND_UINS=

# Web 登录 token。固定值 = 重启后链接不变；走 tailscale serve 的 9443 暴露。
FATFISH_WEB_TOKEN=

# 手机一键取码（docs/runbooks/napcat-qr-phone.md）：
# MCP 专用 bearer（RikkaHub 用）与页面访问钥匙（/s/<key>），与 Web 面板 token 分开。
# 生成：python -c "import secrets; print(secrets.token_hex(24))"（页面钥匙用 16）
NAPCAT_QR_MCP_TOKEN=
NAPCAT_QR_ACCESS_KEY=
