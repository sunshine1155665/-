[Unit]
Description=fatfish QQ adapter (OneBot v11 -> NapCat 3001)
Documentation=file:/opt/fatfish/docs/adr/0012-online-tier.md
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=fatfish
Group=fatfish
WorkingDirectory=/opt/fatfish
EnvironmentFile=/opt/fatfish/.env
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/fatfish/.venv/bin/python -m fatfish --profile cloud --config /opt/fatfish/config/cloud.local.toml qq run
Restart=always
RestartSec=5
MemoryHigh=300M
MemoryMax=400M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/fatfish/data

[Install]
WantedBy=multi-user.target
